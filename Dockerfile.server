FROM node:20-alpine

# openssl is required by the Prisma engine binary on alpine.
RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json* ./
# tsconfig.base.json is REQUIRED at runtime, not just for typechecking. Every
# workspace tsconfig does `"extends": "../tsconfig.base.json"`, and the server
# runs from TS source via tsx, which reads server/tsconfig.json to get the
# `@shared/*` path aliases. If the extends target is missing, the whole
# tsconfig fails to resolve, `paths` is silently lost, and every
# `@shared/...` import falls through to bare-package resolution and dies with
# `ERR_MODULE_NOT_FOUND: Cannot find package '@shared/schemas'` — the server
# container boots, stays "running", and every /api/* request 502s through
# nginx. The bind mounts below cover ./server and ./shared but NOT root-level
# files, so this COPY is the only thing that puts it in the image.
COPY tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY server/prisma ./server/prisma

RUN npm install --workspaces --include-workspace-root
RUN npx --workspace server prisma generate || true

# Bake the workspace SOURCE into the image so the PRODUCTION container is
# self-contained. In dev, docker-compose bind-mounts ./server and ./shared over
# these paths, so this COPY is inert for the preview — it matters only in prod
# (Fly native), where there are NO bind mounts and the image must ship its own
# code. Without it the prod image carries only package.json + prisma and `tsx`
# dies with `ERR_MODULE_NOT_FOUND: src/index.ts` — the container "runs" but never
# binds :3001, so every request 502s (the exact prod-publish failure this fixes).
# .dockerignore keeps node_modules / build output out of these COPYs.
COPY shared ./shared
COPY server ./server

WORKDIR /app/server
EXPOSE 3001

# Installed to /usr/local/bin, NOT left at /app/server/docker-entrypoint.sh, so
# the `./server:/app/server` bind mount in docker-compose.yml cannot shadow it.
COPY server/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# The entrypoint applies pending migrations, then either execs this CMD (dev
# preview → tsx watch) or, when NODE_ENV=production, runs the prod server.
# Without it the API boots against an empty database and every data route 500s.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
