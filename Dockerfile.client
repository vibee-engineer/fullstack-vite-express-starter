# ─── SHARED PREFIX — keep BYTE-IDENTICAL with Dockerfile.server ──────────────
# BuildKit shares layer cache across the two images only while their
# instruction streams are identical. Everything down to `RUN npm ci` matches
# Dockerfile.server exactly, so the expensive workspace install is built ONCE
# per machine and reused by whichever image builds second. It is also the
# layer prebuilt image tarballs warm via compose's cache_from. Diverge only
# BELOW the end-of-prefix marker, and never edit the prefix in one file
# without the other.
#
# openssl: required by the Prisma engine binary on alpine (server-side need);
# ~1 MB in the client image — the price of an identical prefix.
FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app

# Root workspace manifests + workspace package.jsons: the full graph `npm ci`
# needs. tsconfig.base.json is REQUIRED at runtime, not just typechecking —
# every workspace tsconfig does `"extends": "../tsconfig.base.json"`, and the
# bind mounts in docker-compose.yml cover ./client, ./server and ./shared but
# NOT root-level files, so this COPY is the only thing that puts it in the
# image. Without it, `paths` silently fails to resolve and every `@shared/...`
# import dies with ERR_MODULE_NOT_FOUND.
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY client/package.json ./client/
COPY server/package.json ./server/

# npm ci, not npm install: deterministic from the committed lockfile, and it
# fails LOUDLY when package.json and the lockfile disagree instead of silently
# reconciling them (a silent reconcile here defeats the prebuilt-image
# fingerprint downstream). server's postinstall (prisma generate || true)
# no-ops in this layer — the schema is COPYed per-image after the prefix.
RUN npm ci
# ─── END SHARED PREFIX ───────────────────────────────────────────────────────

# `serve` is the production static server (SPA fallback). Installed at BUILD
# time so the prod container never has to reach the npm registry at boot.
RUN npm install -g serve

# Bake the workspace SOURCE into the image so the PRODUCTION container is
# self-contained (dev bind-mounts ./client and ./shared over these, so the COPY
# is inert for the preview). Without it the prod build has no app to compile.
# .dockerignore keeps node_modules / build output out of these COPYs.
COPY shared ./shared
COPY client ./client

WORKDIR /app/client
EXPOSE 5173

# Installed to /usr/local/bin so the `./client:/app/client` dev bind mount cannot
# shadow it. In dev the entrypoint execs the CMD (Vite dev server + HMR); in prod
# (NODE_ENV=production) it builds the static bundle and serves it.
COPY client/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
