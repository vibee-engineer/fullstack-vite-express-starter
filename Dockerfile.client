FROM node:20-alpine

WORKDIR /app

# Copy root workspace manifests + workspace package.jsons so `npm ci` can
# resolve the full graph. Source is bind-mounted at runtime.
COPY package.json package-lock.json* ./
# Needed because client/tsconfig.json does `"extends": "../tsconfig.base.json"`.
# Vite itself resolves `@shared/*` from its own vite.config.ts aliases, so the
# dev server survives without this — but `npm run typecheck -w client` inside
# the container fails to load its tsconfig at all. Copy it so the container is
# not subtly less capable than the host. See Dockerfile.server for the runtime
# failure this same omission caused there.
COPY tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY client/package.json ./client/
COPY server/package.json ./server/

RUN npm install --workspaces --include-workspace-root

WORKDIR /app/client
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
