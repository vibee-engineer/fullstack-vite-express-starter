PORT=3001
NODE_ENV=development

# Postgres variant (default).
DATABASE_URL=postgresql://postgres:postgres@db:5432/app?schema=public

# Mongo variant (opt-in, via docker-compose.mongo.yml). Set MONGO_URL and
# leave DATABASE_URL blank; env.ts will pick whichever is present.
MONGO_URL=

# CORS allowed origin. Match your nginx / public URL.
ALLOWED_ORIGIN=http://localhost:8888

# Dev-only escape hatch. Set to 1 to boot the API WITHOUT a database — routes
# fall back to an in-memory store so you can work on the client before
# `docker compose up -d db` finishes. Every write is lost on restart.
# IGNORED when NODE_ENV=production: a prod boot with no connection string
# still fails fast. Leave unset for normal development.
# SKIP_DB=1

# ── File uploads (server/src/services/storage) ──────────────────────────────
# STORAGE_DRIVER=local writes to UPLOAD_DIR on disk (default, zero infra).
# STORAGE_DRIVER=s3 targets S3/R2/MinIO — then S3_BUCKET + S3_REGION are
# required (and S3_ENDPOINT for R2/MinIO), and you must install the SDK:
#   npm i @aws-sdk/client-s3 -w server
# UPLOAD_DIR=uploads
# STORAGE_DRIVER=local
# MAX_UPLOAD_BYTES=10485760
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PUBLIC_URL=

# ── Email (server/src/services/email) ───────────────────────────────────────
# EMAIL_DRIVER=log logs messages and sends nothing (default, safe in dev).
# EMAIL_DRIVER=resend uses the Resend HTTP API — needs RESEND_API_KEY + EMAIL_FROM.
# EMAIL_DRIVER=ses uses AWS SES v2 — needs SES_REGION + EMAIL_FROM, and:
#   npm i @aws-sdk/client-sesv2 -w server
# EMAIL_DRIVER=log
# EMAIL_FROM=App <hello@yourdomain.com>
# RESEND_API_KEY=
# SES_REGION=

# ── Backups (server/src/services/backups) ───────────────────────────────────
# pg_dump/pg_restore backups, written through the storage driver above — set
# STORAGE_DRIVER=s3 to keep them offsite. Needs the postgresql-client binaries
# on PATH (the server image installs them). Run manually with
# `npm run backup -w server` / `npm run restore -w server -- <key>`, or set a
# daily time to schedule it.
# BACKUP_DAILY_AT=03:00
# BACKUP_RETENTION=7
# BACKUP_PREFIX=backups
