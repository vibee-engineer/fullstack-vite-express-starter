{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    // The server runs from TypeScript source via `tsx` in both dev and prod
    // (see package.json `start`), so nothing is emitted. That keeps one code
    // path for both, and avoids the classic monorepo trap: `tsc` does NOT
    // rewrite path aliases, so an emitted `dist/` would still contain
    // unresolvable `@shared/*` specifiers.
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"],
      "@shared": ["../shared/src/index.ts"]
    }
  },
  // `mongoose/` is included so the Mongo model variant is typechecked even in
  // a Postgres project (nothing statically imports it).
  "include": ["src", "prisma", "mongoose", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
