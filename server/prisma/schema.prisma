// This is your Prisma schema file.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Example resource. The agent replaces this with real models per brief.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Task lifecycle. Mirrors `TASK_STATUSES` in shared/src/schemas/task.ts —
/// keep the two in sync; the zod enum is what validates the wire payload.
enum TaskStatus {
  todo
  in_progress
  done
}

/// THE REFERENCE MODEL. Task is the starter's one end-to-end vertical:
/// schema (shared) → model (here + mongoose/models/Task.ts) → repository →
/// routes → typed client → page. Copy this shape for every new resource.
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(todo)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
}
